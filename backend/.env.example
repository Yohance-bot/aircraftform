# Copy this file to .env and fill in real values for local development.

# Leave unset to use the local SQLite file `registrations.db`.
# For Postgres use the standard SQLAlchemy URL, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# Any shared secret string. The admin dashboard sends this in the
# `X-Admin-Key` header to fetch registrations.
ADMIN_KEY=letsfly

# WhatsApp Business / Meta Cloud API
# Get these from: https://developers.facebook.com → your app → WhatsApp → API Setup
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
ACCESS_TOKEN=

# Meta Embedded Signup (WhatsApp Business App coexistence onboarding)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=2349378865592558
META_GRAPH_API_VERSION=v21.0

# Shared secret you tell Meta in Webhook Configuration → Verify Token.
WEBHOOK_VERIFY_TOKEN=letsfly

# Groq RAG (free-text Q&A). Leave blank to fall back to a canned reply.
# Get one from https://console.groq.com/keys
GROQ_API_KEY=

# Public URL of the frontend, used in WhatsApp replies that link parents back
# to the registration form (e.g. when no registration is found for a number).
FRONTEND_URL=http://localhost:5173

# Number shown to parents in the "Speak to Us" WhatsApp reply.
CONTACT_NUMBER=+91XXXXXXXXXX
